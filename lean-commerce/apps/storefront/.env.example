# ═══════════════════════════════════════════════════════════════════
# lean-commerce Storefront — Umgebungsvariablen
# Kopieren nach .env.local und anpassen
# ═══════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── GraphQL BFF ──────────────────────────────────────────────────────
# Leer lassen wenn BFF als Next.js Route Handler läuft (/api/graphql)
# Setzen wenn BFF als eigenständiger Server läuft
EXTERNAL_BFF_URL=

# ── Security ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-minimum-32-characters-long!!
# Geheimnis für den ISR-Webhook /api/revalidate
REVALIDATE_SECRET=change-me-webhook-secret
# CORS für den GraphQL Endpunkt (leer = alle Origins)
CORS_ORIGIN=

# ── GraphQL Hive (optional) ──────────────────────────────────────────
# Ohne Token: Hive Plugin wird deaktiviert (kein Fehler)
# Token aus: https://app.graphql-hive.com → Project → Settings → Tokens
HIVE_TOKEN=
# CDN Endpunkt für Persisted Operations (aus Hive UI)
HIVE_CDN_ENDPOINT=
HIVE_CDN_KEY=

# ── Externe APIs ──────────────────────────────────────────────────────
# Alle drei APIs sind kostenlos und benötigen KEINEN API-Key!
#
# FakeStore API:  https://fakestoreapi.com     (Produkte, Warenkorb)
# DummyJSON API:  https://dummyjson.com        (Suche, Auth)
# Open-Meteo:     https://api.open-meteo.com   (Wetterdaten)
#
# Keine Konfiguration nötig — direkt nutzbar.

# ── CI/CD ─────────────────────────────────────────────────────────────
# Von CI injiziert (automatisch bei Vercel, GitHub Actions etc.)
# GIT_SHA=abc123
# VERCEL_GIT_COMMIT_SHA=abc123
